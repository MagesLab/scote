# ------------------------------------------------------------------ Fig. S3: sequencing-depth ablation (FF ovarian sections)
OVFF_RAW = [str(DATA / f"raw/{ds}/.extracted") for ds in ("ovff_xenium_5k", "ovff_hd_probe_deep")]
OVFF_RUNS = {"ovff_xenium_5k": "5k_5k_ref_t500", "ovff_hd_probe_deep": "hdd_5k_ref_t500", "ovff_hd_probe_min": "hdm_5k_ref_t500"}
THIN = ["0.125", "0.25", "0.335", "0.5"]

rule ovff_register:
    # H&E registration of the Visium HD probe section (deep and min depth share the slide) into the Xenium 5K frame
    input: OVFF_RAW, str(DATA / "archives/ovff_hd_probe_deep/.downloaded")
    output: "results/ovff/registration/transforms.json"
    log: "logs/ovff/register.log"
    conda: ENV_SCOTE
    threads: 8
    resources: mem_mb=96000, runtime=240
    shell: "python scripts/register_ovff.py --sections ovff_hd_probe_deep > {log} 2>&1"

rule ovff_masks:
    # region masks (tissue, tumor, stroma, immune, necrosis, vessel) in the 5K frame, read by the tile table
    input: "results/ovff/registration/transforms.json", str(DATA / "raw/ovff_xenium_5k/.extracted")
    output: str(DATA / "ovff/masks/regions_10um.npz"), "results/ovff/registration/region_areas.csv"
    log: "logs/ovff/masks.log"
    conda: ENV_SCOTE
    threads: 4
    resources: mem_mb=64000, runtime=120
    shell: "python scripts/masks_ovff.py > {log} 2>&1"

rule ovff_genes:
    # gene set 5k: the 1,000 genes of 5K ∩ Visium HD probe panel with the largest geometric-mean count fraction
    input: molecules("ovff_xenium_5k"), bins2("ovff_hd_probe_deep"), bins2("ovff_hd_probe_min")
    output: "results/ovff/crossplatform/genes_5k.txt", "results/ovff/crossplatform/genes.json"
    log: "logs/ovff/genes.log"
    conda: ENV_SCOTE
    resources: mem_mb=64000, runtime=60
    shell: "python scripts/ovff_crossplatform.py genes --genesets 5k > {log} 2>&1"

OVFF_SECTION = dict((v, k) for k, v in OVFF_RUNS.items())

def ovff_input(w):
    s = OVFF_SECTION[w.run]
    return [molecules(s) if s == "ovff_xenium_5k" else bins2(s), "results/ovff/crossplatform/genes_5k.txt",
            "results/ovff/registration/transforms.json"]

rule ovff_twopoint:
    # registered 2 um lattice run of one section on gene set 5k, 500 um tiles on the fixed grid of the 5K frame
    input: ovff_input
    output: TP + "/ovff/{run}.npz"
    wildcard_constraints: run="|".join(OVFF_RUNS.values())
    params: section=lambda w: OVFF_SECTION[w.run]
    log: "logs/ovff/twopoint_{run}.log"
    conda: ENV_SCOTE
    threads: 4
    resources: mem_mb=96000, runtime=240, gpu=1
    shell: "python scripts/ovff_crossplatform.py twopoint --sections {params.section} --geneset 5k --frame ref > {log} 2>&1"

rule ovff_thinned:
    # the deep Visium HD probe run with the bin counts binomially thinned to a fraction p (seed 0)
    input: bins2("ovff_hd_probe_deep"), "results/ovff/crossplatform/genes_5k.txt", "results/ovff/registration/transforms.json"
    output: TP + "/ovff/hdd_5k_ref_t500_thin{p}.npz"
    wildcard_constraints: p="|".join(t.replace(".", r"\.") for t in THIN)
    log: "logs/ovff/twopoint_thin{p}.log"
    conda: ENV_SCOTE
    threads: 4
    resources: mem_mb=96000, runtime=240, gpu=1
    shell: "python scripts/ovff_crossplatform.py twopoint --sections ovff_hd_probe_deep --geneset 5k --frame ref --thin {wildcards.p} > {log} 2>&1"

rule ovff_tiles:
    # tile table on the fixed 500 um grid: tissue and region fractions, per-section counts, matched tiles
    input: expand(TP + "/ovff/{run}.npz", run=OVFF_RUNS.values()), str(DATA / "ovff/masks/regions_10um.npz")
    output: "results/ovff/crossplatform/tiles_5k_t500.csv", "results/ovff/crossplatform/tiles_5k_t500.json"
    log: "logs/ovff/tiles.log"
    conda: ENV_SCOTE
    resources: mem_mb=32000, runtime=60
    shell: "python scripts/ovff_crossplatform.py tiles --geneset 5k --tile-um 500 --run-tile-um 500 --no-hd3 > {log} 2>&1"

rule depth_tables:
    input: expand(TP + "/ovff/{run}.npz", run=["hdd_5k_ref_t500", "hdm_5k_ref_t500"]),
           expand(TP + "/ovff/hdd_5k_ref_t500_thin{p}.npz", p=THIN), "results/ovff/crossplatform/tiles_5k_t500.csv"
    output: expand("results/ovff/depth/power_{d}.json", d=["deep", "min", "thin0.125", "thin0.25", "thin0.335", "thin0.5"]),
            "results/ovff/depth/scaling.json"
    log: "logs/ovff/depth_tables.log"
    conda: ENV_SCOTE
    resources: mem_mb=64000, runtime=120
    shell: "(python scripts/ovff_depth.py power && python scripts/ovff_depth.py scaling) > {log} 2>&1"

rule make_figS3:
    input: rules.depth_tables.output
    output: "figures/figS3_depth.pdf", "figures/figS3_depth.png"
    log: "logs/figures/make_figS3.log"
    conda: ENV_SCOTE
    resources: mem_mb=4000, runtime=20
    shell: "python figures/make_figS3.py > {log} 2>&1"

# ------------------------------------------------------------------ Fig. S4: sub-micrometer end (CosMx kidney, AVITI24)
rule kidney_fetch:
    # GEO GSE282059 (Reck et al. 2025), CosMx 6k human kidney, slide 2B_FFPE: molecule table and FOV positions
    output: KIDNEY_RAW + "/GSE282059_2B_FFPE_tx_file.csv.gz", KIDNEY_RAW + "/GSE282059_2B_FFPE_fov_positions_file.csv.gz"
    log: "logs/fetch/cosmx_kidney.log"
    conda: ENV_SCOTE
    resources: mem_mb=1000, runtime=240, download=1
    shell:
        "for f in {output}; do curl -L --fail --retry 5 -C - -o $f.part {GEO}/$(basename $f) && mv $f.part $f || exit 1; "
        "gzip -t $f || exit 1; done > {log} 2>&1"

rule kidney_convert:
    input: rules.kidney_fetch.output
    output: "results/cosmx_kidney/convert_summary.json", directory(KIDNEY_PIECE)
    log: "logs/fetch/cosmx_kidney_convert.log"
    conda: ENV_SCOTE
    threads: 4
    resources: mem_mb=32000, runtime=120
    shell: "python scripts/cosmx_kidney_convert.py --threads {threads} > {log} 2>&1"

rule aviti24_convert_well:
    input: str(DATA / "archives/aviti24_a549_screen/.downloaded")
    output: str(DATA / "processed/aviti24_{w}/molecules.parquet"), "results/qc/aviti24_{w}.json"
    log: "logs/fetch/aviti24_{w}.log"
    conda: ENV_SCOTE
    resources: mem_mb=4000, runtime=60
    shell:
        "python -m scote convert --platform aviti24 --rawdir {AVITI24_ZIP} --well {wildcards.w} --sample aviti24_{wildcards.w} "
        "--outdir $(dirname {output[0]}) --qc {output[1]} > {log} 2>&1"

rule kidney_pedestal:
    input: KIDNEY_PIECE, "results/cosmx_kidney/common_genes_matched_aviti24.txt",
           expand(str(DATA / "processed/aviti24_{w}/molecules.parquet"), w=WELLS)
    output: "results/cosmx_kidney/crossplatform_pedestal_bin05_direct.json"
    log: "logs/cosmx_kidney/pedestal.log"
    conda: ENV_SCOTE
    threads: 8
    resources: mem_mb=64000, runtime=240
    shell:
        "python scripts/pedestal_direct.py --threads {threads} --aviti24 recompute "
        "--panel results/cosmx_kidney/common_genes_matched_aviti24.txt --cosmx-dir {KIDNEY_PIECE} --tag kidney_matched "
        "--tensor-dir {TP}/pedestal_bin05_kidney --out-json {output} > {log} 2>&1"

rule kidney_resolution:
    input: KIDNEY_PIECE
    output: "results/cosmx_kidney/resolution.json"
    log: "logs/cosmx_kidney/resolution.log"
    conda: ENV_SCOTE
    threads: 8
    resources: mem_mb=32000, runtime=120
    shell:
        "python scripts/cosmx_resolution.py --processed {KIDNEY_PIECE} --n-fov 16 --delta 0.05 --n-distance-bins 60 --tile-um 200 "
        "--top-genes 150 --threads {threads} --title 'CosMx 6k kidney GSE282059 (analysis piece)' "
        "--out-json {output} --out-fig {QL}/cosmx_kidney_resolution.png > {log} 2>&1"

rule aviti24_zprojection:
    input: expand(str(DATA / "processed/aviti24_{w}/molecules.parquet"), w=BASELINE)
    output: "results/cosmx/aviti24_zprojection_correction.json"
    log: "logs/aviti24/zprojection.log"
    conda: ENV_SCOTE
    threads: 8
    resources: mem_mb=32000, runtime=120
    shell:
        "python scripts/aviti24_zprojection_correction.py --top-genes 50 --baseline-only --threads {threads} "
        "--out-json {output} --out-fig {QL}/aviti24_zprojection_correction.png > {log} 2>&1"

rule make_figS4:
    input: "results/cosmx_kidney/crossplatform_pedestal_bin05_direct.json", "results/cosmx_kidney/resolution.json",
           "results/cosmx/aviti24_zprojection_correction.json"
