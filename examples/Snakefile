# ------------------------------------------------------------------ Fig. 3: molecule level vs cell level on the spleen sections
rule spleen_operators_run:
    # operator labels and the molecule-level two-point run of one section (config/operators_spleen.yaml)
    input: molecules("{section}"), SPLEEN_OPS
    output: TP + "/spleen_operators/{section}.npz", "results/spleen_operators/{section}.json"
    wildcard_constraints: section="|".join(SPLEEN_SECTIONS)
    log: "logs/spleen_operators/run_{section}.log"
    conda: ENV_SCOTE
    threads: 4
    resources: mem_mb=32000, runtime=120
    shell: "python scripts/spleen_operators.py run --section {wildcards.section} --threads {threads} > {log} 2>&1"

rule spleen_three_groups:
    input: expand(TP + "/spleen_operators/{s}.npz", s=SPLEEN_SECTIONS), SPLEEN_OPS
    output: "results/spleen_operators/three_groups.json", "results/spleen_operators/three_groups.md"
    log: "logs/spleen_operators/three_groups.log"
    conda: ENV_SCOTE
    resources: mem_mb=64000, runtime=60
    shell: "python scripts/spleen_operators.py compare3 > {log} 2>&1"

rule spleen_cells:
    # cell typing of the segmented cells with the operator marker sets, Squidpy, and the centroid-level two-point run
    input: str(DATA / "raw/{section}/.extracted"), SPLEEN_OPS
    output: str(DATA / "twopoint/spleen_operators/cells_{section}.parquet"), str(DATA / "twopoint/spleen_operators/centroids_{section}.npz"),
            "results/spleen_operators/cells_{section}.json", "results/spleen_operators/squidpy_{section}.json", "results/spleen_operators/centroids_{section}.json"
    wildcard_constraints: section="|".join(SPLEEN_SECTIONS)
    log: "logs/spleen_operators/cells_{section}.log"
    conda: ENV_SCOTE
    threads: 3
    resources: mem_mb=64000, runtime=180
    shell:
        "(for st in cells squidpy centroids; do python scripts/spleen_cell_baselines.py $st --section {wildcards.section} "
        "--threads {threads} || exit 1; done) > {log} 2>&1"

rule spleen_baselines:
    input: expand(TP + "/spleen_operators/{s}.npz", s=SPLEEN_SECTIONS), expand(TP + "/spleen_operators/centroids_{s}.npz", s=SPLEEN_SECTIONS),
           expand("results/spleen_operators/{k}_{s}.json", k=["cells", "squidpy", "centroids"], s=SPLEEN_SECTIONS)
    output: "results/spleen_operators/baseline_functions.json", "results/spleen_operators/baselines_compare.json"
    log: "logs/spleen_operators/baselines.log"
    conda: ENV_SCOTE
    threads: 3
    resources: mem_mb=64000, runtime=120
    shell: "(python scripts/spleen_cell_baselines.py fit --threads {threads} && python scripts/spleen_cell_baselines.py compare --threads {threads}) > {log} 2>&1"

rule make_fig3:
    input: "results/spleen_operators/baseline_functions.json", "results/spleen_operators/baselines_compare.json", "results/spleen_operators/three_groups.json",
           expand("results/spleen_operators/squidpy_{s}.json", s=SPLEEN_SECTIONS), expand(TP + "/spleen_operators/{s}.npz", s=SPLEEN_SECTIONS)
    output: "figures/fig3_added_value.pdf", "figures/fig3_added_value.png", "results/spleen_operators/fig3_bracket_10um.json"
    log: "logs/figures/make_fig3.log"
    conda: ENV_SCOTE
    resources: mem_mb=4000, runtime=20
    shell: "python figures/make_fig3.py > {log} 2>&1"

