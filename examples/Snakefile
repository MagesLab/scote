# Workflow of the SCOTE examples: from the public data to every table and figure of the methods preprint
# (https://doi.org/10.64898/2026.10.09.757915). Run from this directory (the examples root), with Snakemake from
# envs/snakemake.yml; every rule runs in the conda environment ENV_SCOTE (envs/scote.yml), which Snakemake creates,
# and imports scote from SCOTE_SRC, the src/ of this checkout:
#
#   snakemake -n TARGET                                     # dry run: what would be computed
#   snakemake --sdm conda --configfile config/datasets.yaml config/host.yaml -j 4 --resources gpu=1 TARGET
#
# Targets: all (every figure), fig1 ... fig6, figS1 ... figS4 (preprint numbering), convert_all (download and conversion),
# twopoint_all (the two-point runs), bench_all (the compute benchmark of Fig. 6). Data, intermediates and the two-point
# tensors go to data/ (about 1 TB; make data/ a link to a large volume), tables to results/, figures to figures/; none of
# them is part of the repository. Every rule declares threads, memory and run time, and writes its stdout and stderr to
# its log in logs/.
import shlex
from pathlib import Path

from snakemake.exceptions import WorkflowError
from snakemake.utils import min_version

min_version("8")

from snakemake.settings.types import DeploymentMethod

configfile: "config/datasets.yaml"
configfile: "config/host.yaml"

# the conda environment of the rules; a rule that needs other packages gets an environment file of its own
ENV_SCOTE = str(Path(workflow.basedir) / "envs" / "scote.yml")
# Snakemake removes PYTHONPATH from the environment of conda rules, so every shell command exports it (the prefix keeps
# Snakemake's default "set -euo pipefail")
SCOTE_SRC = Path(workflow.basedir).resolve().parent / "src"
shell.prefix(f"set -euo pipefail; export PYTHONPATH={shlex.quote(str(SCOTE_SRC))}; ")

include: "workflows/fetch.smk"
include: "workflows/twopoint.smk"
include: "workflows/bench.smk"

onstart:
    if DeploymentMethod.CONDA not in workflow.deployment_settings.deployment_method:
        raise WorkflowError("the rules run in conda environments: add --sdm conda (or --use-conda) to the snakemake command")
    if not (SCOTE_SRC / "scote" / "__init__.py").is_file():
        raise WorkflowError(f"the rules import scote from {SCOTE_SRC}, which has no scote package: run the workflow from "
                            "the examples/ directory of a scote checkout")

DATA = Path("data")
TP = str(DATA / "twopoint")
QL = "figures/quicklook"
CRC = ["p1", "p2", "p5"]
LIVER = ["1slice1", "1slice2", "2slice1", "2slice2"]
WELLS = [f"{r}{c}" for r in "ABCDEF" for c in "12"]        # AVITI24 wells (pedestal and panel: all twelve)
BASELINE = WELLS[:6]                                       # A1-C2, the baseline wells of the z-projection
AVITI24_ZIP = str(DATA / "archives/aviti24_a549_screen/cytos_a549_screen.zarr.zip")
KIDNEY_RAW = str(DATA / "raw/cosmx_kidney_gse282059")
KIDNEY_PIECE = str(DATA / "processed/cosmx_kidney_gse282059/piece_2")
GEO = "https://ftp.ncbi.nlm.nih.gov/geo/series/GSE282nnn/GSE282059/suppl"
SPLEEN_OPS = "config/operators_spleen.yaml"
SPLEEN_SECTIONS = ["sb_xenium_WT709_rep1", "sb_xenium_WT713", "sb_xenium_WT710_rep1", "sb_xenium_KO166", "sb_xenium_KO168",
                   "sb_xenium_KO167", "sb_xenium_Ctrl172_rep1", "sb_xenium_Ctrl173_rep1", "sb_xenium_Ctrl174_rep1"]

FIGURES = {"fig1": "fig1_schematic", "fig2": "fig2_platform_invariance", "fig3": "fig3_added_value",
           "fig4": "fig4_error_scaling", "fig5": "fig5_artifacts", "fig6": "fig6_compute",
           "figS1": "figS1_v2_scatter", "figS2": "figS2_spleen_platform_invariance", "figS3": "figS3_depth",
           "figS4": "figS4_subcellular"}

localrules: all, fig1, fig2, fig3, fig4, fig5, fig6, figS1, figS2, figS3, figS4, bench_all, bench_scote_profile, bench_comparators

rule all:
    input: expand("figures/{f}.pdf", f=FIGURES.values())

for _t, _f in FIGURES.items():
    rule:
        name: _t
        input: f"figures/{_f}.pdf"

def molecules(ds): return str(DATA / "processed" / ds / "molecules.parquet")
def bins2(ds): return str(DATA / "processed" / ds / "bins_square_002um.npz")

# ------------------------------------------------------------------ gene panels (scripts/gene_panel.py)
rule genes_crc:
    # the 408 genes common to the Xenium, Visium HD and Visium v2 sections of CRC P2
    input: molecules("xenium_crc_p2"), bins2("hd_crc_p2"), str(DATA / "processed/v2_crc_p2/bins_spots55um.npz")
    output: "results/platforms/common_genes_crc.txt"
    log: "logs/genes/genes_crc.log"
    conda: ENV_SCOTE
    resources: mem_mb=8000, runtime=20
    shell: "python scripts/gene_panel.py common --molecules {input[0]} --bins {input[1]} {input[2]} --out {output} > {log} 2>&1"

rule genes_spleen:
    # the 90 genes common to the Xenium, MERSCOPE and Visium HD sections of WT709
    input: molecules("sb_xenium_WT709_rep1"), molecules("sb_merscope_WT709"), bins2("sb_hd_WT709")
    output: "results/platforms/common_genes_spleen.txt"
    log: "logs/genes/genes_spleen.log"
    conda: ENV_SCOTE
    resources: mem_mb=8000, runtime=20
    shell: "python scripts/gene_panel.py common --molecules {input[0]} {input[1]} --bins {input[2]} --out {output} > {log} 2>&1"

rule genes_liver:
    # the top-200 genes of liver slice 1 (the features of its run), used on the other three slices
    input: TP + "/error_scaling/vizgen_liver1slice1_bin2um_top200.npz"
    output: "results/error_scaling/vizgen_liver_top200_genes.txt"
    log: "logs/genes/genes_liver.log"
    conda: ENV_SCOTE
    resources: mem_mb=4000, runtime=10
    shell: "python scripts/gene_panel.py features --npz {input} --out {output} > {log} 2>&1"

rule genes_aviti24:
    # the 1,000 most abundant 3' genes of the AVITI24 screen present in all twelve wells
    input: expand(str(DATA / "processed/aviti24_{w}/molecules.parquet"), w=WELLS)
    output: "results/aviti24/common_genes_1000.txt"
    log: "logs/genes/genes_aviti24.log"
    conda: ENV_SCOTE
    resources: mem_mb=16000, runtime=60
    shell: "python scripts/gene_panel.py aviti24 --molecules {input} --top 1000 --out {output} > {log} 2>&1"

rule genes_kidney_aviti24:
    # the CosMx kidney top-1000 genes that are also in the AVITI24 panel, in CosMx order (Fig. S4a)
    input: KIDNEY_PIECE, "results/aviti24/common_genes_1000.txt"
    output: "results/cosmx_kidney/common_genes_matched_aviti24.txt"
    log: "logs/genes/genes_kidney_aviti24.log"
    conda: ENV_SCOTE
    resources: mem_mb=16000, runtime=30
    shell: "python scripts/gene_panel.py matched --cosmx-dir {input[0]} --panel {input[1]} --top 1000 --out {output} > {log} 2>&1"

# ------------------------------------------------------------------ Fig. 1 (schematic) and Fig. 2, Figs. S1, S2
rule make_fig1:
    input: molecules("xenium_crc_p2"), TP + "/xenium_crc_p2_mol_common.npz",
           expand(TP + "/{p}_crc_{s}_bin2um_common.npz", p=["xenium"], s=["p1", "p2"]), TP + "/hd_crc_p2_bin2um_common.npz"
    output: "figures/fig1_schematic.pdf", "figures/fig1_schematic.png"
    log: "logs/figures/make_fig1.log"
    conda: ENV_SCOTE
    resources: mem_mb=8000, runtime=20
    shell: "python figures/make_fig1.py > {log} 2>&1"

rule scatter_stats:
    # Pearson / line-fit statistics with closed-form intervals of every method-method scatter (Fig. 2b, Figs. S1, S2b)
    input: TP + "/xenium_crc_p2_mol_common.npz", TP + "/hd_crc_p2_bin2um_common.npz", TP + "/v2_crc_p2_spots_common.npz",
           expand(TP + "/{ds}_bin2um_common.npz", ds=["sb_xenium_WT709_rep1", "sb_hd_WT709", "sb_merscope_WT709"])
    output: "results/platforms/scatter_stats.json"
    log: "logs/platforms/scatter_stats.log"
    conda: ENV_SCOTE
    threads: 4
    resources: mem_mb=96000, runtime=240
    shell: "python scripts/scatter_stats.py > {log} 2>&1"

