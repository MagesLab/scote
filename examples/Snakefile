    input: TP + "/x5k_lymph_node_bin2um_top200.npz"
    output: "results/error_scaling/x5k_lymph_node_top200.json"
    log: "logs/error_scaling/power_x5k_lymph_node.log"
    conda: ENV_SCOTE
    resources: mem_mb=64000, runtime=60
    shell: "python scripts/error_vs_area.py --npz {input} --out {output} > {log} 2>&1"

rule power_liver:
    input: TP + "/error_scaling/vizgen_liver{s}_bin2um_top200.npz"
    output: "results/error_scaling/vizgen_liver{s}_top200.json"
    log: "logs/error_scaling/power_vizgen_liver{s}.log"
    conda: ENV_SCOTE
    resources: mem_mb=64000, runtime=60
    shell: "python scripts/error_vs_area.py --npz {input} --out {output} > {log} 2>&1"

rule molecules_vs_area:
    input: lambda w: [TP + "/xenium_crc_p2_bin2um_common.npz", "results/error_scaling/xenium_crc_p2_top200.json"]
                     + expand(TP + "/error_scaling/xenium_crc_p2_bin2um_common_mol{m}.npz", m=MOL_FRACTIONS)
                     if w.ds == "xenium_crc_p2" else
                     [TP + "/x5k_lymph_node_bin2um_top200.npz", "results/error_scaling/x5k_lymph_node_top200.json"]
                     + expand(TP + "/error_scaling/x5k_lymph_node_bin2um_top200_mol{m}.npz", m=MOL_FRACTIONS)
    output: "results/error_scaling/{ds}_molecules.json"
    wildcard_constraints: ds="xenium_crc_p2|x5k_lymph_node"
    params: opt=lambda w: "" if w.ds == "xenium_crc_p2" else f"--dataset {w.ds}"
    log: "logs/error_scaling/molecules_{ds}.log"
    conda: ENV_SCOTE
    resources: mem_mb=64000, runtime=60
    shell: "python scripts/error_vs_molecules.py {params.opt} > {log} 2>&1"

rule replicates_crc:
    input: "results/platforms/crc_replicates.json"
    output: "results/error_scaling/replicates_sections.json"
    log: "logs/error_scaling/replicates_crc.log"
    conda: ENV_SCOTE
    resources: mem_mb=4000, runtime=10
    shell: "python scripts/error_vs_replicates.py crc > {log} 2>&1"

rule replicates_liver:
    input: expand(TP + "/error_scaling/vizgen_liver{s}_bin2um_top200.npz", s=LIVER)
    output: "results/error_scaling/replicates_liver.json"
    log: "logs/error_scaling/replicates_liver.log"
